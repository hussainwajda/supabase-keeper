# Registry project (the Supabase project that stores your accounts/projects list)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only, never exposed to the browser

# Password to log into this dashboard
APP_PASSWORD=change-me
# Random string used to sign the session cookie (openssl rand -hex 32)
SESSION_SECRET=
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes (openssl rand -hex 32)
CRON_SECRET=
