# ─── Registry ────────────────────────────────────────────────────────────────
# The Supabase project that stores Keepstack's own tables (accounts, projects, secrets,
# logs) AND provides authentication. It can be one of your existing hobby projects.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# The anon / publishable key. Safe in the browser — RLS is what protects your rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Bypasses RLS; used by the nightly sweep and the one-time legacy claim.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Site ────────────────────────────────────────────────────────────────────
# Used to build OAuth and email redirect URLs. Optional locally (inferred from the
# request); set it in production so links don't point at an internal proxy host.
# NEXT_PUBLIC_SITE_URL=https://keepstack.yourdomain.com

# Set to "true" to hide the Google button (e.g. before you've configured the provider).
# KEEPSTACK_DISABLE_GOOGLE=false

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes (openssl rand -hex 32)
CRON_SECRET=

# ─── One-time migration helper ───────────────────────────────────────────────
# Enables the dashboard's "Claim these rows" banner for registries that predate sign-in.
# Remove it once you've claimed, then run 0004_require_owner.sql.
# KEEPSTACK_ALLOW_LEGACY_CLAIM=true

# ─── Vault ───────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 32. They MUST be different values.
#
# KEEPSTACK_MASTER_KEY encrypts server-tier secrets (provider API keys, anon keys) and the
# recovery copy of each user's key. Back it up to a password manager BEFORE storing anything:
# lose it and every server-tier secret is unrecoverable.
#
# KEEPSTACK_PIN_PEPPER is mixed into the PIN key derivation. Keeping it out of the database
# is what stops a stolen database from being brute-forced offline.
#
# See docs/SECURITY.md for the full threat model, including what this does not protect.
KEEPSTACK_MASTER_KEY=
KEEPSTACK_PIN_PEPPER=

# ─── Vault email recovery (optional) ─────────────────────────────────────────
# Without these, the PIN still works and the vault is fully usable — only the
# "I forgot my PIN" recovery path needs email.
# RESEND_API_KEY=re_...
# KEEPSTACK_FROM_EMAIL=keepstack@a-domain-you-verified-with-resend.com

# Development only: print OTP codes to the server log instead of emailing them. Ignored when
# NODE_ENV=production, so it cannot be switched on in a real deployment.
# KEEPSTACK_OTP_DEV_ECHO=true

# Optional but recommended while KEEPSTACK_ALLOW_LEGACY_CLAIM is on: pin the claim to one
# account, so the banner and the action only work for the email you intend to claim with.
# KEEPSTACK_LEGACY_CLAIM_EMAIL=you@example.com
