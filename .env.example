# ─── Registry ────────────────────────────────────────────────────────────────
# The Supabase project that stores Keepstack's own tables (accounts, projects, logs).
# It can be one of your existing hobby projects — the tables won't clash.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only, never exposed to the browser

# ─── Auth ────────────────────────────────────────────────────────────────────
# Single-password login. Phase 1 replaces this with Supabase Auth + Google.
APP_PASSWORD=change-me
# Signs the session cookie (openssl rand -hex 32)
SESSION_SECRET=

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes (openssl rand -hex 32)
CRON_SECRET=

# ─── Vault (Phase 2 — not read yet) ──────────────────────────────────────────
# Generate each with: openssl rand -base64 32. They must be different values.
# Back KEEPSTACK_MASTER_KEY up to a password manager before your first deploy:
# losing it means every server-tier secret is unrecoverable. See docs/SECURITY.md.
# KEEPSTACK_MASTER_KEY=
# KEEPSTACK_PIN_PEPPER=
