{
  "compilerOptions": {
    "target": "ES2022",
    /*
      DOM is here for one reason: the provider adapters in src/providers/ are verbatim copies
      of the Next.js app's, and they pass `cache: "no-store"` to fetch. That option lives on
      the DOM's RequestInit, not on the one @types/node declares, so without this lib the
      copies wouldn't compile and would have to be edited — which would mean they could no
      longer be re-copied when the originals change. No DOM API is actually used.
    */
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": { "@/*": ["./src/*"] },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
