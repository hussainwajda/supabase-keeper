# ─── MongoDB ─────────────────────────────────────────────────────────────────
# The only variable with no default. Everything else can be left alone to run locally.
#   local:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://user:password@cluster0.ab12c.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
# Kept separate from the URI so one cluster can host dev and prod.
MONGODB_DB=keepstack

# ─── HTTP ────────────────────────────────────────────────────────────────────
PORT=4000
# Origins allowed to send credentialed requests. Cookie auth can't use a wildcard, so this
# is a comma-separated list of exact origins — the Next.js frontend's, typically.
CORS_ORIGIN=http://localhost:3000
# This backend's own public URL. Used to build the Google OAuth redirect URI.
# PUBLIC_URL=https://api.keepstack.yourdomain.com
# Where to send the browser after an OAuth round trip (the frontend, not this API).
# APP_URL=https://keepstack.yourdomain.com

# ─── Sessions ────────────────────────────────────────────────────────────────
SESSION_TTL_DAYS=30
# Set both only when the frontend is on a different site than this API. `sameSite=none`
# requires `secure`, which requires HTTPS — so this combination cannot work over plain http.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.yourdomain.com

# ─── Vault ───────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 32. They MUST be different values.
#
# IMPORTANT when migrating an existing Supabase registry: these have to be the SAME values
# that registry was using. The ciphertexts move across unchanged, and they only decrypt under
# the key that sealed them — a new KEEPSTACK_MASTER_KEY makes every server-tier secret
# unreadable, and a new KEEPSTACK_PIN_PEPPER stops every vault PIN from working.
#
# Back KEEPSTACK_MASTER_KEY up to a password manager before storing anything: lose it and
# every server-tier secret is unrecoverable. See docs/SECURITY.md for the threat model.
KEEPSTACK_MASTER_KEY=
KEEPSTACK_PIN_PEPPER=

# ─── Signup ──────────────────────────────────────────────────────────────────
# Closed by default — a self-hosted Keepstack is usually one person's. The very first account
# is always allowed through, so a fresh deployment can create its own user.
# ALLOW_SIGNUP=true

# ─── Google sign-in (optional) ───────────────────────────────────────────────
# Leave unset and the Google route is disabled with an explanation; email and password still
# work. Authorised redirect URI in the Google console must be:
#   $PUBLIC_URL/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Run the sweep inside this process. The thing the Next.js app can't do: a serverless function
# has no process to hold a timer, which is why it needs Vercel Cron and is capped at one run
# per day on the Hobby plan.
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_HOURS=24
# Only needed to trigger the sweep over HTTP (Vercel Cron, GitHub Actions, a crontab + curl).
# Same contract as the Next.js route: Authorization: Bearer $CRON_SECRET
# Generate with: openssl rand -hex 32
# CRON_SECRET=

# ─── Vault email recovery (optional) ─────────────────────────────────────────
# Without these the PIN still works and the vault is fully usable — only the "I forgot my PIN"
# recovery path needs email.
# RESEND_API_KEY=re_...
# KEEPSTACK_FROM_EMAIL=keepstack@a-domain-you-verified-with-resend.com
# Development only: print codes to the log instead of emailing them. Ignored when
# NODE_ENV=production, so it can't be switched on in a real deployment.
# KEEPSTACK_OTP_DEV_ECHO=true

# ─── Migrating from Supabase (only needed by `pnpm migrate`) ─────────────────
# The registry to read from. The service-role key is required: the migration has to read
# auth.users and every row regardless of RLS. Remove both once the migration is done.
# SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
